# UPI Inspector configuration. Copy to .env, or run:  python manage.py setup
# Never commit .env.

APP_ENV=local
# Demo mode shortens timers, exposes the demo control and API docs, and returns one-time codes to the app.
DEMO_MODE=true
# Who may use the passwordless demo sign-in: off | local (this machine only) | lan (private addresses too) | any
DEMO_LOGIN=local

# "pgserver" runs the embedded PostgreSQL 16 under PG_DATA_DIR (no Docker needed).
# Or point at any PostgreSQL:  postgresql://user:password@host:5432/postgres
DATABASE_URL=pgserver
PG_DATA_DIR=.data/pg
DATABASE_NAME=upi

# "fakeredis://" keeps the cache inside the API process. Or a real Redis:  redis://localhost:6379/0
REDIS_URL=fakeredis://

# memory | redis | kafka
EVENT_BUS=memory
KAFKA_BROKERS=localhost:9092
WORKERS_IN_PROCESS=true

# Secrets: generated by "python manage.py setup"
JWT_SECRET=
PHONE_HASH_KEY=
CONSORTIUM_KEY=
SERVICE_API_KEYS=
SEED_STAFF_PASSWORD=
SEED_USER_PIN=

# Sessions: minutes without use before a sign-in lapses, and the longest a session can last
USER_TOKEN_MINUTES=30
STAFF_TOKEN_MINUTES=60
SESSION_MAX_HOURS=12
# A decision clears a payment for this many seconds after its last approval
CLEARANCE_TTL_S=600
# true accepts "biometric passed" from the app without a proof from an enrolled device (never outside a demo)
TRUST_CLIENT_BIOMETRIC=false
# Requests a minute from one address (service keys are exempt); 0 turns it off
RATE_LIMIT_PER_IP=1200
MAX_BODY_BYTES=65536
# Extra Host names the API answers to, besides this machine and private addresses; * turns the check off
ALLOWED_HOSTS=
# true refuses plain HTTP from anywhere but this machine (set it wherever TLS is in front)
REQUIRE_HTTPS=false

MODEL_DIR=ml/artifacts
TEXT_MODEL=tfidf
HOT_PATH_TIMEOUT_MS=300
# Assessments allowed in flight; beyond this a payment gets the safe default at once
MAX_INFLIGHT=48
PG_FALLBACK_TIMEOUT_MS=40
GRAPH_JOB_INTERVAL_S=120
MONITOR_INTERVAL_S=900

# Short timers used when DEMO_MODE=true
HOLD_SECONDS_DEMO=60
GUARDIAN_TIMEOUT_S_DEMO=120
COOLOFF_SECONDS_DEMO=10
UNBLOCK_SECONDS_DEMO=60

# AI case summaries (optional). With no keys the template summary is used.
LLM_PROVIDERS=gemini,groq,ollama,template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# Web pages allowed to call the API: local (this machine and private addresses) | a list of origins | *
CORS_ORIGINS=local
PUBLIC_BASE_URL=http://localhost:8000
