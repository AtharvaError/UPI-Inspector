{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["manage.py", "api", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "payer-app",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/mobile/node_modules/expo/bin/cli", "start", "apps/mobile", "--port", "8081", "--offline"],
      "port": 8081
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/dashboard/node_modules/next/dist/bin/next", "start", "apps/dashboard", "-p", "3000"],
      "port": 3000
    }
  ]
}
